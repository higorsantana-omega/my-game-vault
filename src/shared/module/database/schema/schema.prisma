generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String

  @@map("user")
}

model Game {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  releaseDate DateTime
  platforms   String[]
  imageUrl    String
  rating      Json
  rawgId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("game")
}
